# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gestion_gastos

# JWT
JWT_SECRET=your-super-secret-key-min-16-characters

# Database Sync (only for development)
DB_SYNCHRONIZE=false

# Database SSL (use for production)
DB_SSL=false

# API URLs
FRONTEND_URL=http://localhost:5173

# AI Services (Optional)
GROQ_API_KEY=your-groq-api-key-for-ticket-ocr
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Email Service (Optional)
RESEND_API_KEY=your-resend-api-key

# Environment
NODE_ENV=production
