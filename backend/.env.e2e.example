# Copiar a .env.e2e.local y completar con tus valores de Supabase.
# Luego ejecutar: RUN_E2E=true RUN_RBAC_E2E=true npm run test:e2e

DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=pon_un_secreto_largo_para_tests
ANTHROPIC_API_KEY=
PORT=3001
DB_SSL=true
DB_SYNCHRONIZE=false

RUN_E2E=true
RUN_RBAC_E2E=true
